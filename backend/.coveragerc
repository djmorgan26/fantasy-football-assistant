# Coverage configuration.
#
# The important line here is `concurrency`. SQLAlchemy's async layer runs
# database work inside greenlets, and coverage cannot see into a greenlet
# unless it is told to. Without this, every endpoint body that touches the
# database reads as unexecuted: app/api/board.py measured 37% while its tests
# were exercising 86% of it. Every coverage number taken before this file
# existed was wrong in the same direction.
[run]
concurrency = greenlet,thread
source = app
branch = false
omit =
    app/demo_main.py
    app/working_main.py
    */__pycache__/*

[report]
skip_covered = false
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    \.\.\.
