# =====================================================================
# MOCK / DEMO MODE
# =====================================================================
# Run the WHOLE app with no external credentials and no real API calls.
# ESPN, Sleeper, and Groq are all short-circuited to realistic sample data,
# and the database is forced to a local SQLite file (no Postgres needed).
#
# Launch:
#   Backend:  cd backend && ./venv/bin/python -m uvicorn app.main:app \
#               --reload --env-file ../.env.mock --port 8000
#   Frontend: cd frontend && npm run dev
#
# Then log in at http://localhost:3000 with:
#   email:    demo@demo.app
#   password: demo1234
# (A "Use demo account" button is shown on the login page in mock mode.)
# =====================================================================

MOCK_MODE=true

# Safe local defaults; no real secrets required in mock mode.
SECRET_KEY=mock-mode-insecure-secret-not-for-production
DEBUG=true
RELOAD=true
LOG_LEVEL=INFO

# CORS for the Vite dev server
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# NOTE: DATABASE_URL is intentionally omitted. Mock mode always uses SQLite
# (fantasy_mock.db) regardless of this value.

# GROQ is optional in mock mode. With no key, the content engine returns its
# data-driven facts fallback. Add a key here to also exercise real AI writing
# against the mock league data.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

VITE_API_URL=http://localhost:8000/api
